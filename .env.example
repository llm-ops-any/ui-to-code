# 复制本文件为 .env 后填入真实值（.env 不要提交到仓库）

# 腾讯云对象存储配置信息
# 密钥获取：https://console.cloud.tencent.com/cam/capi
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
# 存储桶所在地域，如 ap-guangzhou
COS_REGION=ap-guangzhou
COS_SCHEME=https
# 存储桶名称，格式：<bucket-name>-<appid>，如 imooc-llmops-1304251364
COS_BUCKET=your-bucket-name-your-appid
# 自定义访问域名，留空则使用默认域名
COS_DOMAIN=

# LLMOps开放API配置
LLMOPS_APP_ID=your-app-id
LLMOPS_API_BASE=https://llmops.shortvar.com/api/openapi
LLMOPS_API_KEY=your-api-key
